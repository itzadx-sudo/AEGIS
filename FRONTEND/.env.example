# Backend origin for the Sedona FastAPI server (api.py).
#
# Leave EMPTY for local dev — vite.config.js proxies the API route prefixes
# (/uploads, /sessions, /knowledge-base, /health) to API_PROXY_TARGET
# (default http://localhost:8080), so relative fetches just work with no CORS.
#
# Set this to the full backend origin for a deployed build, e.g.
#   VITE_API_BASE_URL=https://sedona-api.example.com
VITE_API_BASE_URL=
VITE_CSRF_COOKIE=sedona_csrf

# Authentication uses an HttpOnly session cookie. No credential belongs in the
# frontend environment or production JavaScript bundle.
