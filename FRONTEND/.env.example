# Aegis frontend environment.
#
# Leave VITE_API_BASE_URL empty for local dev: Vite proxies the API route
# prefixes (/uploads, /sessions, /knowledge-base, /health) to the backend, so
# the frontend can use relative paths with no CORS setup.
#
# For a deployed build, set this to the backend origin, e.g.
#   VITE_API_BASE_URL=https://aegis-api.example.edu
VITE_API_BASE_URL=

# Only needed if the API server runs somewhere other than http://localhost:8080
# (consumed by vite.config.js for the dev proxy).
# API_PROXY_TARGET=http://localhost:8080
