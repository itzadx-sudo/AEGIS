# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── Node / Vite ──────────────────────────────────────────
node_modules/
dist/
.vite/
*.local

# ── Secrets ──────────────────────────────────────────────
.env
!.env.example
!**/.env.example

