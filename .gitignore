chroma_db/
reports/
uploads_tmp/
logs/
auth/

# ── OS / editor cruft ────────────────────────────────────
.DS_Store

# ── Large test fixtures (kept on disk, excluded from git) ──
big.xlsx

# editor/backup copies — .env.save escaped the .env rule and held a live key
*.save

# Local working agreement for Claude — deliberately not shared
CLAUDE.md

# Local QA scaffolding — probes and harnesses, kept off the VM and out of git
qa-local/

# Dev documentation — kept locally and in ~/Documents/MD, off the deployment target
docs/
changes.md
TEAM_GIT_SETUP.md
.claude/

# Test harnesses and ad-hoc probes — dev material, kept on the Mac, off the VM
BACKEND/test_*.py
BACKEND/test_*.sh
BACKEND/check_*.py
BACKEND/run_all_unit_tests.py

# QA venv and test logs — Mac-only, never committed or deployed
.venv-qa/

# Bootstrap-installed toolchain and model weights — large, machine-specific, regenerable
.runtime/
models/

# Editor and design-tool config — local to a workstation, not part of the app
.design-sync/

# extracted vendor evidence — session-scoped and written 0600, same class as reports/
evidence/
