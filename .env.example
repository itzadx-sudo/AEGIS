# Copy to .env on the VM and load it from the service manager. Never commit .env.

# Python
SEDONA_PYBIN=/path/to/python

# Which inference stack serves the models. Defaults to llama_cpp on Linux and ollama on macOS,
# so neither platform normally needs this set.
#   llama_cpp — two local llama.cpp servers on separate ports (needs an NVIDIA GPU)
#   ollama    — one local Ollama daemon; "*-cloud" tags are proxied to ollama.com
SEDONA_LLM_BACKEND=llama_cpp

# Model selection. Under ollama these are real tags the daemon resolves (see `ollama list`);
# under llama_cpp they are display labels and the GGUF paths below are what actually load.
# The committed default lives in BACKEND/config.py — set these only to override it.
SEDONA_LLM_MODEL=gemma4:31b-cloud
SEDONA_EMBED_MODEL=nomic-embed-text

# ── llama_cpp backend only ───────────────────────────────────────────────────
SEDONA_MODEL_DIR=/path/to/models
SEDONA_LLM_GGUF=/path/to/chat-model.gguf
SEDONA_EMBED_GGUF=/path/to/embedding-model.gguf

# Local inference services. Defaults are 8000 / 8001 under llama_cpp; under ollama both default
# to 11434, because one daemon answers chat and embeddings from the same port.
SEDONA_LLM_HOST=127.0.0.1
SEDONA_LLM_PORT=8000
SEDONA_EMBED_HOST=127.0.0.1
SEDONA_EMBED_PORT=8001

# API and browser access
SEDONA_API_HOST=127.0.0.1
SEDONA_API_PORT=8080
SEDONA_FRONTEND_HOST=0.0.0.0
SEDONA_FRONTEND_PORT=5173
SEDONA_PUBLIC_URL=http://sedona.example.internal:5173
SEDONA_CORS_ORIGINS=http://sedona.example.internal:5173

# Persistent state and logs
SEDONA_DATA_DIR=/path/to/persistent/sedona-data
SEDONA_EVIDENCE_DIR=/path/to/persistent/sedona-data/evidence
SEDONA_LOG_DIR=/path/to/persistent/sedona-logs

# First-start bootstrap. These are read only when the user database is empty.
# Remove both variables from the runtime environment immediately after first start.
SEDONA_BOOTSTRAP_ADMIN_USERNAME=sedona-admin
SEDONA_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-strong-password
SEDONA_BOOTSTRAP_ADMIN_DISPLAY_NAME=Sedona Administrator

# Cookie policy. Set true when Sedona is served over HTTPS.
SEDONA_COOKIE_SECURE=false
SEDONA_SESSION_HOURS=8

# Institutional applicability. Vendor questionnaire routing cannot override a
# true value. Set a scope to false only after the institution documents that it
# is out of scope for this deployment.
SEDONA_APPLICABILITY_HIPAA=true
SEDONA_APPLICABILITY_FERPA=true
SEDONA_APPLICABILITY_COPPA=true
SEDONA_APPLICABILITY_PCI_DSS=true
SEDONA_APPLICABILITY_PRIVACY=true
SEDONA_APPLICABILITY_AI=true
SEDONA_APPLICABILITY_ACCESSIBILITY=true
SEDONA_APPLICABILITY_CLOUD=true
SEDONA_APPLICABILITY_ON_PREMISES=true
